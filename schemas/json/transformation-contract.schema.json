{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/foio/schema/transformation-contract/1.0.0",
  "title": "FOI-O transformation contract",
  "description": "Stable, occurrence-independent contract for one deterministic transformation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "stage",
    "accepted_input_schema_versions",
    "output_schema_versions",
    "algorithm",
    "rules",
    "required_capabilities",
    "prohibited_successor_capabilities",
    "compatibility",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "foio.transformation-contract.v1.0.0"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stage": {"type": "string", "minLength": 1},
    "accepted_input_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "output_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "canonicalization"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "canonicalization": {"const": "foio.sorted-compact-json.v1"}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordering", "duplicates", "missingness", "exclusions"],
      "properties": {
        "ordering": {"type": "string", "minLength": 1},
        "duplicates": {"type": "string", "minLength": 1},
        "missingness": {"type": "string", "minLength": 1},
        "exclusions": {"type": "string", "minLength": 1}
      }
    },
    "parameters": {
      "type": "object",
      "description": "Stable parameter definitions; occurrence-specific values belong in the envelope.",
      "additionalProperties": true
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "prohibited_successor_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_contract_behavior", "supersedes"],
      "properties": {
        "unknown_contract_behavior": {"const": "reject"},
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"}
  }
}
