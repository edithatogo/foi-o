{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/foio/schema/provenance-envelope/1.0.0",
  "title": "FOI-O provenance envelope",
  "description": "Content-addressed link between a stable transformation contract and one execution occurrence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "canonicalization",
    "transformation_contract",
    "run_occurrence",
    "authorization",
    "inputs",
    "outputs",
    "population",
    "successor_effects",
    "lineage",
    "envelope_sha256"
  ],
  "properties": {
    "schema_version": {"const": "foio.provenance-envelope.v1.0.0"},
    "envelope_id": {"type": "string", "minLength": 1},
    "canonicalization": {"const": "foio.sorted-compact-json.v1"},
    "transformation_contract": {
      "$ref": "https://w3id.org/foio/schema/transformation-contract/1.0.0"
    },
    "run_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "repository",
        "commit",
        "dirty_worktree",
        "command",
        "started_at",
        "completed_at",
        "implementation_sha256",
        "dependency_lock_sha256",
        "parameters",
        "run_occurrence_sha256"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_worktree": {"type": "boolean"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "parameters": {"type": "object", "additionalProperties": true},
        "environment": {"type": "object", "additionalProperties": true},
        "run_occurrence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization": {
      "$ref": "https://w3id.org/foio/schema/authorization-record/1.0.0"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "population_sha256",
        "predecessor",
        "included",
        "excluded",
        "unresolved"
      ],
      "properties": {
        "population_id": {"type": "string", "minLength": 1},
        "population_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor": {"type": "integer", "minimum": 0},
        "included": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    },
    "successor_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predecessor_sha256", "relationship"],
        "properties": {
          "predecessor_sha256": {"$ref": "#/$defs/sha256"},
          "relationship": {"enum": ["observed_derivation", "supersedes", "amends"]}
        }
      }
    },
    "envelope_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "size_bytes", "schema_version"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "schema_version": {"type": "string", "minLength": 1},
        "path_hint": {"type": "string", "minLength": 1}
      }
    }
  }
}
