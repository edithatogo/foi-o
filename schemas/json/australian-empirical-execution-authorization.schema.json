{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foi-o.example/schemas/australian-empirical-execution-authorization.schema.json",
  "title": "Empirical execution authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "status",
    "run_spec_sha256",
    "membership_sha256",
    "codebook_sha256",
    "calibration_sha256",
    "approved_roles",
    "capabilities",
    "authorizer_identity",
    "external_approval",
    "authorization_sha256"
  ],
  "properties": {
    "schema_version": {"const": "foio.empirical-execution-authorization.v1.0.0"},
    "authorization_id": {"type": "string", "minLength": 1},
    "status": {"const": "approved"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "membership_sha256": {"$ref": "#/$defs/sha256"},
    "codebook_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_sha256": {"$ref": "#/$defs/sha256"},
    "approved_roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frame.prepare",
          "frame.finalize",
          "sampling.membership.prepare",
          "packet.generate",
          "annotation.execute",
          "adjudication.queue.prepare",
          "reliability.compute_descriptive",
          "extractor_metrics.compute",
          "maturity.compare_thresholds"
        ]
      }
    },
    "authorizer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "identity_kind"],
      "properties": {
        "identity_id": {"type": "string", "minLength": 1},
        "identity_kind": {"const": "external_human"}
      }
    },
    "external_approval": {"$ref": "#/$defs/externalApproval"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "externalApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_sha256",
        "approved_context_sha256",
        "approver_identity"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "approved_context_sha256": {"$ref": "#/$defs/sha256"},
        "approver_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_id", "identity_kind"],
          "properties": {
            "identity_id": {"type": "string", "minLength": 1},
            "identity_kind": {"const": "external_human"}
          }
        }
      }
    }
  }
}
