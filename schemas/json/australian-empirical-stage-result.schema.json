{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/foio/schema/australian-empirical-stage-result/1.0.0",
  "title": "Australian empirical stage result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_spec_sha256",
    "stage_id",
    "stage_sequence",
    "stage_spec_sha256",
    "result_status",
    "input_sha256",
    "output_sha256",
    "population",
    "allowed_capabilities",
    "denied_capabilities",
    "stage_result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "foio.australian-empirical-stage-result.v1.0.0"},
    "run_id": {"type": "string", "pattern": "^run:au-[a-z0-9._:-]+$"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "stage_id": {"type": "string", "pattern": "^stage:[a-z0-9._:-]+$"},
    "stage_sequence": {"type": "integer", "minimum": 1},
    "stage_spec_sha256": {"$ref": "#/$defs/sha256"},
    "result_status": {"enum": ["completed", "failed", "skipped"]},
    "input_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "output_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "population": {"$ref": "#/$defs/population"},
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "denied_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "stage_result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "population_sha256",
        "predecessor",
        "included",
        "excluded",
        "unresolved"
      ],
      "properties": {
        "population_id": {"type": "string", "minLength": 1},
        "population_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor": {"type": "integer", "minimum": 0},
        "included": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    }
  }
}
