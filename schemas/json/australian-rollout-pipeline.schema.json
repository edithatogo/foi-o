{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foi-o.example/schemas/australian-rollout-pipeline.schema.json",
  "title": "Bounded Australian jurisdiction rollout pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_id",
    "jurisdiction",
    "profile_id",
    "status",
    "population",
    "provenance",
    "gates",
    "stages",
    "failure_dispositions",
    "definition_sha256",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "foi-o.australian-rollout-pipeline.v1"
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^AU-[A-Z]{2,3}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["planned", "active", "paused", "completed", "failed"]
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "maximum_unit_count",
        "root_membership_sha256",
        "expansion_authorized"
      ],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "maximum_unit_count": {"type": "integer", "minimum": 0},
        "root_membership_sha256": {"$ref": "#/$defs/sha256"},
        "expansion_authorized": {"const": false}
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/gate"}
    },
    "stages": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/stage"}
    },
    "failure_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/failure"}
    },
    "resume_checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "media_type"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "repository_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository_revision": {"$ref": "#/$defs/sha256"}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformation_id", "version", "parameters_sha256"],
      "properties": {
        "transformation_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameters_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "transformation"],
      "properties": {
        "producer": {"$ref": "#/$defs/producer"},
        "transformation": {"$ref": "#/$defs/transformation"}
      }
    },
    "stagePopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_count",
        "membership_sha256",
        "parent_membership_sha256"
      ],
      "properties": {
        "unit_count": {"type": "integer", "minimum": 0},
        "membership_sha256": {"$ref": "#/$defs/sha256"},
        "parent_membership_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "inputs",
        "outputs",
        "population",
        "provenance"
      ],
      "properties": {
        "name": {
          "enum": [
            "discover",
            "select",
            "replay",
            "reconcile",
            "classify",
            "validate",
            "manifest",
            "frame",
            "sample",
            "calibrate",
            "annotate",
            "evaluate",
            "maturity_packet"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "active",
            "completed",
            "blocked",
            "failed",
            "skipped"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactPin"}
        },
        "outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactPin"}
        },
        "additional_predecessor_stages": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 11,
          "items": {
            "enum": [
              "discover",
              "select",
              "replay",
              "reconcile",
              "classify",
              "validate",
              "manifest",
              "frame",
              "sample",
              "calibrate",
              "annotate",
              "evaluate"
            ]
          }
        },
        "population": {"$ref": "#/$defs/stagePopulation"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "before_stage",
        "required",
        "authorization_state"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "before_stage": {
          "enum": [
            "discover",
            "select",
            "replay",
            "reconcile",
            "classify",
            "validate",
            "manifest",
            "frame",
            "sample",
            "calibrate",
            "annotate",
            "evaluate",
            "maturity_packet"
          ]
        },
        "required": {"const": true},
        "authorization_state": {
          "enum": ["not_authorized", "externally_authorized"]
        },
        "authorized_by": {"const": "external_human"},
        "authorization_evidence_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorization_state": {"const": "externally_authorized"}
            }
          },
          "then": {
            "required": ["authorized_by", "authorization_evidence_sha256"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["authorized_by"]},
                {"required": ["authorization_evidence_sha256"]}
              ]
            }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_id",
        "stage",
        "failure_type",
        "status",
        "unit_count",
        "message"
      ],
      "properties": {
        "failure_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"
        },
        "stage": {
          "enum": [
            "discover",
            "select",
            "replay",
            "reconcile",
            "classify",
            "validate",
            "manifest",
            "frame",
            "sample",
            "calibrate",
            "annotate",
            "evaluate",
            "maturity_packet"
          ]
        },
        "failure_type": {
          "enum": [
            "retryable_transient",
            "terminal_not_found",
            "rights_excluded",
            "out_of_scope",
            "integrity_mismatch",
            "authorization_missing",
            "population_expansion",
            "upstream_invalid"
          ]
        },
        "status": {
          "enum": ["open", "resolved", "excluded"]
        },
        "unit_count": {"type": "integer", "minimum": 0},
        "message": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "retry_after": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_sha256",
        "last_completed_stage",
        "stage_output_sha256",
        "population_membership_sha256",
        "checkpoint_sha256"
      ],
      "properties": {
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "last_completed_stage": {
          "enum": [
            "discover",
            "select",
            "replay",
            "reconcile",
            "classify",
            "validate",
            "manifest",
            "frame",
            "sample",
            "calibrate",
            "annotate",
            "evaluate",
            "maturity_packet"
          ]
        },
        "stage_output_sha256": {"$ref": "#/$defs/sha256"},
        "population_membership_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
