{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/foio/schema/australian-empirical-extractor-metrics/1.0.0",
  "title": "Australian empirical descriptive extractor metrics artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "run_id", "run_spec_sha256", "membership_sha256",
    "codebook_sha256", "population_sha256", "calibration_artifact_sha256",
    "authorization_artifact_sha256", "calibration_sha256", "authorization_sha256",
    "source_bundle_sha256", "annotation_lineage", "reference_sha256", "unit_count",
    "label_metrics", "coverage", "all_unit_exact_span", "exact_span", "span_iou",
    "provenance_completeness", "confusion_rows", "gold_promotion_authorized",
    "profile_promotion_authorized", "publication_authorized", "redistribution_authorized",
    "training_authorized", "extractor_metrics_sha256"
  ],
  "properties": {
    "schema_version": {"const": "foio.empirical-extractor-metrics.v1.0.0"},
    "status": {"const": "computed_descriptive"},
    "run_id": {"type": "string", "pattern": "^run:au-[a-z0-9._:-]+$"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "membership_sha256": {"$ref": "#/$defs/sha256"},
    "codebook_sha256": {"$ref": "#/$defs/sha256"},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "annotation_lineage": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/annotationLineage"}
    },
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "unit_count": {"type": "integer", "minimum": 1},
    "label_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["true_positive", "false_positive", "false_negative", "precision", "recall", "f1"],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f1": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "coverage": {"$ref": "#/$defs/rate"},
    "all_unit_exact_span": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator", "estimate", "eligibility", "threshold_eligible"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "estimate": {"type": "number", "minimum": 0, "maximum": 1},
        "eligibility": {"const": "all_units_including_null_labels"},
        "threshold_eligible": {"const": false}
      }
    },
    "exact_span": {"$ref": "#/$defs/eligibleNullableRate"},
    "span_iou": {"oneOf": [{"$ref": "#/$defs/spanIou"}, {"type": "null"}]},
    "provenance_completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["required_fields", "numerator", "denominator", "estimate", "threshold_eligible"],
      "properties": {
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "threshold_eligible": {"const": false}
      }
    },
    "confusion_rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "unit_sha256", "reference_label", "predicted_label", "label_match", "exact_span_match", "span_threshold_eligible"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "unit_sha256": {"$ref": "#/$defs/sha256"},
          "reference_label": {"type": ["string", "null"]},
          "predicted_label": {"type": ["string", "null"]},
          "label_match": {"type": "boolean"},
          "exact_span_match": {"type": "boolean"},
          "span_threshold_eligible": {"type": "boolean"}
        }
      }
    },
    "gold_promotion_authorized": {"const": false},
    "profile_promotion_authorized": {"const": false},
    "publication_authorized": {"const": false},
    "redistribution_authorized": {"const": false},
    "training_authorized": {"const": false},
    "extractor_metrics_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotationLineage": {
      "type": "object", "additionalProperties": false,
      "required": ["role_id", "packet_sha256", "annotation_set_sha256"],
      "properties": {
        "role_id": {"type": "string", "minLength": 1},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "annotation_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rate": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator", "estimate"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "estimate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "eligibleNullableRate": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator", "estimate", "eligibility", "threshold_eligible"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "eligibility": {"const": "matching_non_null_label"},
        "threshold_eligible": {"const": true}
      }
    },
    "spanIou": {
      "type": "object", "additionalProperties": false,
      "required": ["threshold", "matched", "denominator", "estimate", "eligibility", "threshold_eligible"],
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "matched": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "eligibility": {"const": "matching_non_null_label"},
        "threshold_eligible": {"const": false}
      }
    }
  }
}
