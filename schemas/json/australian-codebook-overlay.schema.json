{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foi-o:schema:australian-codebook-overlay:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_id",
    "version",
    "core",
    "jurisdiction",
    "profile",
    "regime",
    "effective_interval",
    "pins",
    "assertions",
    "overrides"
  ],
  "properties": {
    "schema_version": {"const": "foi-o.australian-codebook-overlay.v1"},
    "overlay_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_id", "version", "sha256"],
      "properties": {
        "core_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "jurisdiction": {"type": "string", "pattern": "^AU-(CTH|NSW|VIC|QLD|SA|WA|TAS|ACT|NT)$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "jurisdiction"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "pattern": "^AU-"}
      }
    },
    "regime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime_id", "name", "jurisdiction"],
      "properties": {
        "regime_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "pattern": "^AU-"}
      }
    },
    "effective_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": ["string", "null"], "format": "date"}
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_pack", "ontology"],
      "properties": {
        "source_pack": {"$ref": "#/$defs/pin"},
        "ontology": {"$ref": "#/$defs/pin"}
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "jurisdiction", "statement", "positive_criteria", "negative_criteria"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": "string", "pattern": "^AU-"},
          "statement": {"type": "string", "minLength": 10},
          "positive_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "negative_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maximum_span_characters": {"type": "integer", "minimum": 1}
          }
        },
        "terminology": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "calibration_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text", "rationale"],
            "properties": {
              "label": {"enum": ["observed", "inferred", "candidate", null]},
              "abstention_reason": {"enum": ["missing_evidence", "insufficient_evidence", "out_of_scope", "other"]},
              "text": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1}
            },
            "oneOf": [
              {
                "properties": {"label": {"enum": ["observed", "inferred", "candidate"]}},
                "not": {"required": ["abstention_reason"]}
              },
              {
                "properties": {"label": {"type": "null"}},
                "required": ["abstention_reason"]
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
