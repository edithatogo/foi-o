{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/foio/schema/authorization-record/1.0.0",
  "title": "FOI-O authorization record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "status",
    "object_scope",
    "population_scope",
    "population_id",
    "population_sha256",
    "transformation_id",
    "transformation_version",
    "transformation_contract_sha256",
    "run_id",
    "run_occurrence_sha256",
    "approved_input_sha256",
    "allowed_capabilities",
    "denied_capabilities",
    "approval_statement",
    "approval_statement_sha256",
    "one_use",
    "authorization_sha256"
  ],
  "properties": {
    "schema_version": {"const": "foio.authorization-record.v1.0.0"},
    "authorization_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending_human_decision", "approved", "rejected"]},
    "object_scope": {"type": "string", "minLength": 1},
    "population_scope": {"type": "string", "minLength": 1},
    "population_id": {"type": "string", "minLength": 1},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "transformation_id": {"type": "string", "minLength": 1},
    "transformation_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "transformation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "run_occurrence_sha256": {"$ref": "#/$defs/sha256"},
    "approved_input_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "denied_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "approval_statement": {"type": "string", "minLength": 1},
    "approval_statement_sha256": {"$ref": "#/$defs/sha256"},
    "one_use": {"type": "boolean"},
    "predecessor_authorization_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver_role", "decided_at"],
      "properties": {
        "approver_role": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"}
      }
    },
    "authorization_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pending_human_decision"}}},
      "then": {"not": {"required": ["human_decision"]}},
      "else": {"required": ["human_decision"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"}
  }
}
